== Part A: the unit engine (core/openferment_core/units.py) ==
controls:
  normalize('mg'      ) = 'mg'             family mass
  normalize('mL'      ) = 'mL'             family volume
  normalize('mm'      ) = 'mm'             family length
  normalize('s'       ) = 's'              family time
  normalize('g'       ) = 'g'              family mass
  normalize('t d⁻¹'   ) = 't d⁻¹'          family massFlow
  normalize('Mg/d'    ) = None             family None
  normalize('ML/d'    ) = None             family None
  normalize('furlongs') = None             family None
  normalize('G L-1'   ) = 'g L⁻¹'          family massConc
  normalize('KDa'     ) = 'kDa'            family molarMass
probes (each names a unit the table does not hold):
  normalize('Mg'      ) = 'mg'             family mass      (Mg is megagram (10^6 g, a tonne))
  normalize('MG'      ) = 'mg'             family mass      (MG is megagram, upper case)
  normalize('ML'      ) = 'mL'             family volume    (ML is megalitre (10^6 L))
  normalize('Mm'      ) = 'mmol L⁻¹'       family molar     (Mm is megametre (10^6 m))
  normalize('MM'      ) = 'mmol L⁻¹'       family molar     (MM is megamolar)
  normalize('S'       ) = 's'              family time      (S is siemens)
  normalize('G'       ) = 'g'              family mass      (G is gauss, or the giga prefix alone)
conversions:
  convert(1, 'Mg', 'kg')       = 1e-06   (a megagram is 1000 kg)
  convert(2, 'Mg', 'g')        = 0.002   (2 Mg is 2e6 g)
  convert(1, 'ML', 'L')        = 0.001   (a megalitre is 1e6 L)
  convert(1, 'Mg/d', 'kg d⁻¹') = UnitError(Unknown unit: Mg/d)
checkpoint grading (units.quantity_equals, the Python twin of src/engine/units.ts quantityEquals):
  quantity_equals((2000, 'kg'), (2, 'Mg'), 5) = False   (2000 kg is 2 Mg)
  quantity_equals((2, 'mg'),    (2, 'Mg'), 5) = True   (2 mg is 2e-9 Mg)

