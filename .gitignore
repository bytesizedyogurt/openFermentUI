node_modules/
dist/
.DS_Store
*.local
.vite/

# ── openferment-core (OF-BLD-007) ──────────────────────────────────────
# The API key lives in core/.env and must never be committed. This entry is
# checked by `pnpm check:secrets`, which runs as the first stage of verify —
# a rule that silently stops matching is worse than no rule.
core/.env
core/.env.*
!core/.env.example
.venv/
core/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# Generated by `pnpm export:corpus` from the TypeScript seed, which is the
# source of truth. Committing it would create a second copy to drift.
core/openferment_core/data/corpus.json
