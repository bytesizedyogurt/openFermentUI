node_modules/
dist/
.DS_Store
*.local
.vite/

# ── openferment-core (OF-BLD-007) ──────────────────────────────────────
# The API key lives in core/.env and must never be committed. This entry is
# checked by `pnpm check:secrets`, which runs as the first stage of verify —
# a rule that silently stops matching is worse than no rule.
core/.env
core/.env.*
!core/.env.example
.venv/
core/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# Generated by `pnpm export:corpus` from the TypeScript seed, which is the
# source of truth. Committing it would create a second copy to drift.
core/openferment_core/data/corpus.json
# Generated by `pnpm export:unit-fixtures` from src/engine/units.ts — the
# TypeScript engine's answers, which tests/test_units.py asserts the Python
# mirror reproduces. Regenerated by `pnpm test:core`; committing it would let a
# stale copy pass for the engine's current behaviour.
core/tests/fixtures/units.json
# OF-BLD-012 §2.2 — fetched full text and model output stay local. The text
# spans several licences and is regenerable with one command; the candidates
# are model output and cost only tokens to remake. biorepo.json, the human
# decisions, is the one data file that IS committed.
core/data/fulltext/
core/data/candidates/
