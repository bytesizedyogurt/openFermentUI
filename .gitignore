node_modules/
dist/
.DS_Store
*.local
.vite/
.cache/

# ── the service (core/) ────────────────────────────────────────────────
# The API key lives in core/.env and must never be committed. This entry is
# checked by `pnpm check:secrets`, which runs as the first stage of verify —
# a rule that silently stops matching is worse than no rule.
core/.env
core/.env.*
!core/.env.example
.venv/
core/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Written by `pnpm test:core` from the client's TypeScript before the suite
# runs (scripts/export-*.ts); a committed copy would be a second source that
# drifts from the code it records.
core/tests/fixtures/units.json
core/tests/fixtures/resolvers.json
core/tests/fixtures/fields.json
core/tests/fixtures/competence.json
core/tests/fixtures/lock-digests.json

# What this machine fetches for itself, fetched again when gone: the genome-
# scale models geneOS computes on (THIRD_PARTY.md gives each its source and
# hash) and the SFF toolkit's reference flowsheets, checked against
# core/openferment_core/engine/sff_library.json.
core/data/models/
core/data/sff-library/

# ── alpha 1.0's files ──────────────────────────────────────────────────
# A checkout that ran alpha 1.0 (the live Mini) still holds these until
# `pnpm db:import-alpha1` carries its records into a project; nothing in alpha
# 2.0 reads or writes them, and none may enter git by accident. Guild's
# ledger, practice sessions and checks are personnel data and never enter git.
core/openferment_core/data/
core/data/fulltext/
core/data/candidates/
core/data/artifacts/
core/data/index/
core/data/rageval/
core/data/live/
core/data/demo/
core/data/identifiers-proposed.tsv
core/data/guild.json
**/guild.json
core/data/practice.json
**/practice.json
core/data/checks.json
**/checks.json
**/checks.json.lock
core/data/spend.json
core/data/spend.json.lock
core/data/audit.jsonl
core/data/audit.jsonl.lock
core/data/proposals.json
core/data/proposals.json.lock
core/data/pureos-trains.json
core/data/pureos-trains.json.lock
# A build spec or a session's prompt copied to the root.
/OF-BLD-*.md
/PROMPT*.md
