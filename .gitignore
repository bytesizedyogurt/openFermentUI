node_modules/
dist/
.DS_Store
*.local
.vite/

# ── openferment-core (OF-BLD-007) ──────────────────────────────────────
# The API key lives in core/.env and must never be committed. This entry is
# checked by `pnpm check:secrets`, which runs as the first stage of verify —
# a rule that silently stops matching is worse than no rule.
core/.env
core/.env.*
!core/.env.example
.venv/
core/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
# Generated by `pnpm export:corpus` from the TypeScript seed, which is the
# source of truth. Committing it would create a second copy to drift.
core/openferment_core/data/corpus.json
# OF-BLD-013 §1.2 — Guild's projection of the skills seed, written beside the
# corpus by the same export, for the same reason.
core/openferment_core/data/skills.json
# OF-BLD-015 §7.1 — the modules' projection, written beside it by the same exporter.
core/openferment_core/data/modules.json
# Generated by `pnpm export:unit-fixtures` from src/engine/units.ts — the
# TypeScript engine's answers, which tests/test_units.py asserts the Python
# mirror reproduces. Regenerated by `pnpm test:core`; committing it would let a
# stale copy pass for the engine's current behaviour.
core/tests/fixtures/units.json
# OF-BLD-014 §2.1 — the strain and carbon-source resolvers' answers, written by
# the same exporter from src/data/strains.ts and src/data/vocabulary.ts, which
# tests/test_validate.py asserts validate.py reproduces. Same reason.
core/tests/fixtures/resolvers.json
# Generated by `pnpm export:unit-fixtures` from src/data/ontology.ts; test_schema.py
# holds it equal to core/openferment_core/schema/fields.yaml.
core/tests/fixtures/fields.json
# Generated by `pnpm export:competence-fixtures` from src/engine/competence.ts,
# for the same reason (OF-BLD-013 §2.1).
core/tests/fixtures/competence.json
# Generated by `pnpm export:lock-fixtures` from src/engine/lock.ts: the
# browser's lock digests, which tests/test_runbook_lock.py asserts the
# service's port (runbook_lock.py) reproduces. Same reason.
core/tests/fixtures/lock-digests.json
# OF-BLD-012 §2.2 — fetched full text and model output stay local. The text
# spans several licences and is regenerable with one command; the candidates
# are model output and cost only tokens to remake. biorepo.json, the human
# decisions, is the one data file that IS committed.
core/data/fulltext/
core/data/candidates/
# §8.1 — `pnpm demo:offline` runs the service against a scratch copy of the
# data directory so the demo never writes into the committed biorepo.json.
core/data/demo/
# Crossref's proposals (OF-BLD-012.1 F9). A proposal is not a fact: what is
# approved lands in src/data/corpus/ as a seed change, with a commit.
core/data/identifiers-proposed.tsv
# OF-BLD-013 §1.2 — Guild's ledger: who holds which skill, and who signed it.
# Personnel data, and this repository is public, so it never enters git. The
# Mac Mini keeps it; where its backup goes is a decision for Sean. The second
# line covers OPENFERMENT_DATA_DIR pointed anywhere else inside the checkout.
core/data/guild.json
**/guild.json
# OF-BLD-013 §4 — Practice: scenarios and sessions, each session a person's
# own words in answer to the tutor. Kept with the ledger, out of git.
core/data/practice.json
**/practice.json
# OF-BLD-013 §5.2 — checks: who is to be watched at the bench, and how they
# did. Personnel data, out of git with the ledger.
core/data/checks.json
**/checks.json
**/checks.json.lock

# ── the working prototype (OF-BLD-014) ─────────────────────────────────
# OF-BLD-014 §1.1 — a spec at the root is one session's copy; the specs live in Notion.
/OF-BLD-*.md
# OF-BLD-014 §1.1 — the prompt that starts a session, kept out of git with its spec.
/PROMPT*.md
# OF-BLD-014 E.5 — computed artifacts, replayable from their inputs; the data branch keeps them.
core/data/artifacts/
# OF-BLD-014 §4.1 — the passage index, rebuilt on each machine from the text it fetched.
core/data/index/
# OF-BLD-014 §6.2 — downloaded model files; THIRD_PARTY.md gives each its source and hash.
core/data/models/
# alpha 2.0 (ADR-003) — the SFF toolkit's reference flowsheets, fetched from the
# pinned commit and checked against core/openferment_core/engine/sff_library.json.
core/data/sff-library/
# OF-BLD-014 §4.3 — retrieval questions and their scores; the data branch keeps them.
core/data/rageval/
# OF-BLD-014 E.10 — what the live runs saved; the data branch carries it between machines.
core/data/live/
# OF-BLD-014 E.7 — the day's model spend, kept on the machine that spent it.
core/data/spend.json
# OF-BLD-015 §7.3, §7.4 — the audit log and the proposals; on this machine, like spend.
core/data/audit.jsonl
core/data/audit.jsonl.lock
core/data/proposals.json
core/data/proposals.json.lock
core/data/spend.json.lock
# OF-BLD-020 §5.4 — the trains a model built with pureos_build, kept on this
# machine like the proposals; not on the data branch.
core/data/pureos-trains.json
core/data/pureos-trains.json.lock
.cache/
