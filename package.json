{
  "name": "openferment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:seed": "tsx scripts/check-seed.ts",
    "check:lock": "tsx scripts/check-lock.ts",
    "check:capture": "tsx scripts/check-capture.ts",
    "test:durable": "node scripts/check-durable.mjs",
    "test:deposition": "node scripts/check-deposition.mjs",
    "test:reconcile": "node scripts/check-reconcile.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:golden": "node scripts/golden-path.mjs",
    "verify": "pnpm check:secrets && pnpm typecheck && pnpm check:plan && pnpm check:reference && pnpm test:core && pnpm check:seed && pnpm check:lock && pnpm check:capture && pnpm build && pnpm test:durable && pnpm test:deposition && pnpm test:reconcile && pnpm test:smoke && pnpm test:golden && pnpm test:deep",
    "test:deep": "node scripts/deep-paths.mjs",
    "bundle:single": "pnpm build && node scripts/bundle-single.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "export:corpus": "tsx scripts/export-corpus.ts",
    "check:plan": "node scripts/check-plan.mjs",
    "export:fixtures": "tsx scripts/export-flow-fixtures.ts",
    "test:core": "pnpm export:corpus && cd core && uv run pytest tests/ -q -m \"not live\"",
    "test:live": "cd core && uv run pytest tests/ -q -m live -s",
    "check:reference": "tsx scripts/check-reference.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/spectral": "^5.1.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
