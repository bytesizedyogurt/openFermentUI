{
  "name": "@openferment/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:seed": "tsx scripts/check-seed.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:golden": "node scripts/golden-path.mjs",
    "verify": "pnpm typecheck && pnpm check:seed && pnpm check:corpus && pnpm check:units && pnpm check:protocol && pnpm check:metrics && pnpm check:aggregation && pnpm check:python && pnpm check:biosteam && pnpm build && pnpm test:smoke && pnpm test:golden && pnpm test:deep",
    "test:deep": "node scripts/deep-paths.mjs",
    "bundle:single": "vite build --mode offline && node scripts/bundle-single.mjs",
    "check:biosteam": "tsx scripts/check-biosteam.ts",
    "check:units": "tsx scripts/check-units-parity.mjs",
    "check:protocol": "tsx scripts/check-protocol-parity.mjs",
    "check:metrics": "tsx scripts/check-metrics-parity.mjs",
    "check:aggregation": "tsx scripts/check-aggregation-parity.mjs",
    "check:python": "node scripts/check-python.mjs",
    "export:corpus": "tsx scripts/export-corpus.ts",
    "check:corpus": "tsx scripts/export-corpus.ts --check",
    "capture:fixtures": "tsx scripts/capture-fixtures.ts",
    "capture:answer-shapes": "tsx scripts/capture-answer-shapes.ts",
    "gen:types": "node scripts/gen-types.mjs",
    "check:schema": "python3 packages/core/scripts/validate_fixtures.py"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/spectral": "^5.1.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "json-schema-to-typescript": "^15.0.4",
    "playwright": "^1.62.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
