# Copy to core/.env and fill in. core/.env is gitignored; never commit it, and
# never read it into anything under src/ — the browser must not see a key.
#
# Set a spend limit in the Anthropic console before the first call. Not because
# the volume is risky, but because a cap turns a runaway loop from a bill into
# a bug report.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Which models answer, and how hard they think (core/openferment_core/llm.py).
# Defaults: Claude Opus 5.5 first, Claude Sonnet 5.5 when Opus declines or is
# unavailable, effort medium (low, medium, high, xhigh or max). Leave them
# commented out to use the defaults. OPENFERMENT_FALLBACK_MODEL may name several
# models, comma-separated, tried in order after the first.
# OPENFERMENT_MODEL=claude-opus-5-5
# OPENFERMENT_FALLBACK_MODEL=claude-sonnet-5-5
# OPENFERMENT_EFFORT=medium

# Optional. The model for bulk index chores (OF-BLD-014 E.7): retrieval helper
# calls and writing evaluation questions. Falls back to the chain above.
# OPENFERMENT_INDEX_MODEL=claude-haiku-5-5

# Optional. Spend guards inside the service (OF-BLD-014 D8), in US dollars.
# The daily cap covers every model call in a UTC day; llm.py refuses a call
# that could pass it. The per-question cap bounds one Postdoc question (§5.2).
# OPENFERMENT_DAILY_BUDGET_USD=25
# OPENFERMENT_ASK_BUDGET_USD=0.75
