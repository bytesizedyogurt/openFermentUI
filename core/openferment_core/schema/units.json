 "refusals": [
  {
   "a": "proteinShare",
   "b": "massConc",
   "because": "A share of total soluble protein and a concentration are not interconvertible without the cell density and the total-protein fraction of the biomass. Record those two values and the conversion becomes possible; guessing them would fabricate a titer."
  },
  {
   "a": "proteinShare",
   "b": "percent",
   "because": "Both are percentages but of different denominators — % of total soluble protein is not % of dry weight or % of native phosphorylation sites. Comparing them directly is a category error."
  },
  {
   "a": "costUSD",
   "b": "costEUR",
   "because": "Currency conversion needs an exchange rate with a date attached. The engine will not invent one — record the rate and the date as an explicit assumption."
  },
  {
   "a": "percentCdw",
   "b": "massConc",
   "because": "A share of dry cell mass and a concentration are not interconvertible without the biomass density of that culture. Record the dry cell weight per litre the paper reports for it and the conversion becomes possible; guessing it would fabricate a titre."
  },
  {
   "a": "specMolarRate",
   "b": "specProd",
   "because": "A rate in moles per gram per hour and one in grams per gram per hour differ by the molar mass of what is taken up or made. Record which substance it is and convert by its molar mass as a stated step; the engine will not assume it."
  },
  {
   "a": "costUSDVolume",
   "b": "costUSD",
   "because": "A price per gallon and a price per kilogram are not interconvertible without the density of the product. Record the density the analysis assumes for it and the conversion becomes possible; guessing it would fabricate a price."
  }
 ]
