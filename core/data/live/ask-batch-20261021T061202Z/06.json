    {
      "id": "c10",
      "text": "The Dominion, fermOS, Proforma, pureOS and Runbooks modules returned no rows specific to ethanol fermentation by Saccharomyces cerevisiae in this search: no clearance finding, fitted kinetic run, simulation, costed scenario run or runbook.",
      "recordIds": [],
