{
  "question": "What does openFerment hold on ethanol fermentation by Saccharomyces cerevisiae, and in which modules?",
  "claims": [
    {
      "id": "c2",
      "text": "openFerment's BioRepo module holds extracted, unverified candidate records of ethanol titre and ethanol yield on glucose for Saccharomyces cerevisiae strains, drawn from the ethanol-tolerance, glycerol-reduction and Calvin-cycle papers.",
      "recordIds": [
        "cl1-Q18-7e796665",
        "cl1-Q7-2f3dcdbc",
        "cl1-Q7-2b034640",
        "cl1-Q10-1a38257c"
      ],
      "paperIds": [
        "Q10",
        "Q18",
        "Q7"
      ],
      "support": "direct",
      "provenance": "unverified",
      "passages": [],
      "evidenceIds": [],
      "moduleRefs": []
    },
    {
      "id": "c3",
      "text": "In the glycerol-formation study, the wild-type Saccharomyces cerevisiae strain reached a final ethanol titre on glucose that is the reference for the reduced-glycerol mutants.",
      "recordIds": [
        "cl1-Q7-2f3dcdbc"
      ],
      "paperIds": [
        "Q7"
      ],
      "support": "direct",
      "provenance": "unverified",
      "passages": [],
      "evidenceIds": [],
      "moduleRefs": []
    },
    {
      "id": "c4",
      "text": "In the glycerol-formation study, the glycerol-reduced mutants reached lower final ethanol titres than the wild-type strain.",
      "recordIds": [
        "cl1-Q7-2f3dcdbc"
      ],
      "paperIds": [
        "Q7"
      ],
      "support": "direct",
      "provenance": "unverified",
      "passages": [],
      "evidenceIds": [],
      "moduleRefs": []
    },
    {
      "id": "c5",
      "text": "Ethanol yield on glucose for the CEN.PK113-7D strain in the glycerol-formation study under anaerobic conditions.",
      "recordIds": [
        "cl1-Q7-2b034640"
      ],
      "paperIds": [
        "Q7"
      ],
      "support": "direct",
      "provenance": "unverified",
      "passages": [],
      "evidenceIds": [],
      "moduleRefs": []
    },
    {
      "id": "c6",
      "text": "Ethanol yield on glucose for the IMX774 Calvin-cycle strain in the anaerobic Calvin-cycle study, reported with its glycerol yield.",
      "recordIds": [
        "cl1-Q10-1a38257c"
      ],
      "paperIds": [
        "Q10"
      ],
      "support": "direct",
      "provenance": "unverified",
      "passages": [],
      "evidenceIds": [],
      "moduleRefs": []
    },
    {
      "id": "c7",
      "text": "Ethanol titre of the CEN.PK113-7D strain evolved under high-ethanol selection, compared with the parental strain in a fermentation of the evolved and parental strains.",
      "recordIds": [
        "cl1-Q18-7e796665",
        "cl1-Q18-310f0b42"
      ],
      "paperIds": [
        "Q18"
      ],
      "support": "direct",
